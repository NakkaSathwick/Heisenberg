:root {
  --bg-dark: #0b0b0b;
  --text-light: #d0ff8f;
  --accent-green: #89ff00;
  --gold: #ffd700;
  --muted-light: #999;
}

body {
  background: var(--bg-dark);
  color: var(--text-light);
  font-family: 'Bebas Neue', sans-serif;
  overflow-x: hidden;
  margin: 0;
  padding: 0;
}

/* Header logo */
header {
  position: absolute;
  top: 20px;
  left: 40px;
  z-index: 10;
  display: flex;
  align-items: center;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.symbol {
  background: #004d00;
  color: var(--gold);
  font-size: 2rem;
  padding: 10px 15px;
  border-radius: 6px;
  box-shadow: 0 0 15px rgba(255, 215, 0, 0.7);
}

.name {
  font-size: 2rem;
  color: var(--accent-green);
  text-shadow: 0 0 15px var(--accent-green);
}

.hero {
  position: relative;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
  overflow: hidden;
  background: radial-gradient(circle, #0b0b0b 20%, #000 100%);
}

.line-layer {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(
      120deg,
      rgba(255, 215, 0, 0.1) 0%,
      rgba(137, 255, 0, 0.05) 100%
    ),
    repeating-linear-gradient(
      45deg,
      rgba(255, 215, 0, 0.2),
      rgba(255, 215, 0, 0.2) 2px,
      transparent 2px,
      transparent 40px
    );
  animation: moveLines 6s linear infinite;
  z-index: 0;
}

@keyframes moveLines {
  from { background-position: 0 0; }
  to { background-position: 400px 400px; }
}

.hero-content {
  z-index: 2;
}

h1 {
  font-size: 5rem;
  color: var(--accent-green);
  letter-spacing: 3px;
  text-shadow: 0 0 20px var(--accent-green);
}

.subtitle {
  font-size: 2rem;
  color: var(--gold);
  margin-top: -20px;
  text-shadow: 0 0 20px var(--gold);
}

.tagline {
  font-size: 1.5rem;
  color: var(--muted-light);
}

.btn {
  margin: 10px;
  padding: 12px 24px;
  background: var(--accent-green);
  color: #000;
  text-decoration: none;
  border: 2px solid var(--accent-green);
  border-radius: 4px;
  transition: 0.3s;
}

.btn:hover {
  background: var(--gold);
  color: #000;
  box-shadow: 0 0 25px var(--gold);
}

.btn.outline {
  background: transparent;
  color: var(--accent-green);
  border-color: var(--accent-green);
}

.content {
  padding: 60px 10%;
  text-align: center;
}

.card {
  background: #121212;
  border: 1px solid #333;
  border-radius: 10px;
  padding: 30px;
  margin-bottom: 40px;
  box-shadow: 0 0 15px rgba(137, 255, 0, 0.2);
}

footer {
  background: #111;
  color: var(--muted-light);
  text-align: center;
  padding: 20px 0;
  font-size: 0.9rem;
}

/* Welcome animation */
.welcome-overlay {
  position: fixed;
  background: radial-gradient(circle, #000 10%, #0b0b0b 100%);
  color: var(--gold);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: fadeOut 4s ease-out forwards;
}

@keyframes fadeOut {
  0% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; visibility: hidden; }
}

.welcome-text {
  font-size: 4rem;
  text-shadow: 0 0 40px var(--gold);
}

/* Animated quotes */
.quotes-container {
  position: absolute;
  bottom: 10%;
  width: 100%;
  text-align: center;
  z-index: 1;
}

.quote {
  font-size: 1.5rem;
  color: var(--gold);
  text-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
  opacity: 0;
  animation: quoteFade 10s infinite;
}

@keyframes quoteFade {
  0%, 100% { opacity: 0; transform: translateY(20px); }
  20%, 80% { opacity: 1; transform: translateY(0); }
}
.connect-btn {
  display: inline-block;
  background: linear-gradient(45deg, gold, orange);
  color: black;
  font-weight: bold;
  font-size: 18px;
  text-decoration: none;
  padding: 12px 30px;
  border-radius: 30px;
  box-shadow: 0 0 15px gold;
  transition: all 0.3s ease;
}

.connect-btn:hover {
  background: linear-gradient(45deg, orange, gold);
  box-shadow: 0 0 30px yellow;
  transform: scale(1.1);
}


